# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase web configuration. These values are supplied to the browser build.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Firebase Admin SDK project selection for the server.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Optional Supabase connection. Leave unset to use the local demo store.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# B-01: with Supabase configured, sign-in uses Supabase Auth only (see supabase/AUTH_SETUP.md).
# Usernames map to <username>@VITE_AUTH_EMAIL_DOMAIN; must match the manage-account function's AUTH_EMAIL_DOMAIN secret.
VITE_AUTH_EMAIL_DOMAIN="accounts.homegym.app"
# Dev builds only: set to "demo" to use the local demo accounts even with Supabase configured.
# Production builds ignore this.
VITE_AUTH_MODE=""

# ── PostgreSQL ────────────────────────────────────────────────
# یا DATABASE_URL، یا SQL_HOST / SQL_PORT / SQL_USER / SQL_PASSWORD / SQL_DB_NAME
DATABASE_URL="postgres://homegym:homegym_dev_password@localhost:5432/homegym"
# SQL_SSL="true"              # اگر دیتابیس اتصال رمزنگاری‌شده می‌خواهد

# docker compose (سرویس db) از این‌ها برای ساخت دیتابیس استفاده می‌کند
POSTGRES_USER="homegym"
POSTGRES_PASSWORD="change-me-to-a-long-random-password"
POSTGRES_DB="homegym"

# ── نشست کاربران ─────────────────────────────────────────────
# حداقل ۳۲ نویسهٔ تصادفی:  openssl rand -hex 32
JWT_SECRET=""
# پشت HTTPS (تولید) true بماند؛ فقط برای توسعهٔ محلی روی http مقدار false بدهید
COOKIE_SECURE="true"
# پشت nginx یا هر reverse proxy: تعداد proxyها (برای IP درست در محدودیت تلاش ورود)
TRUST_PROXY="1"

# ── seed (bun run db:seed) ───────────────────────────────────
# مدیر کل اولیه (فقط اگر وجود نداشته باشد ساخته می‌شود)
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""
# باشگاه نمونه با دادهٔ آزمایشی (فقط برای محیط آزمایشی)
SEED_DEMO="false"
SEED_DEMO_PASSWORD=""

# ── پشتیبان‌گیری (سرویس backup) ──────────────────────────────
BACKUP_TIME="03:00"            # به وقت تهران
BACKUP_RETENTION_DAYS="14"
BACKUP_HOST_DIR="./backups"
